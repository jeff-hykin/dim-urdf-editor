{
    "tasks": {
        "dev": "deno run -A --watch backend/main.ts --port 8787",
        "test": "deno test -A backend/",
        "check": "deno check backend/main.ts && deno task check-endpoints",
        "check-endpoints": "deno run -A scripts/check_endpoints.ts"
    },
    "fmt": {
        "indentWidth": 4,
        "semiColons": false,
        "lineWidth": 120,
        "exclude": [
            "frontend/dist",
            "frontend/node_modules"
        ]
    },
    "lint": {
        "exclude": [
            "frontend/dist",
            "frontend/node_modules"
        ],
        "rules": {
            "exclude": [
                "no-import-prefix"
            ]
        }
    }
}
